# ---- Zabbix ----
ZABBIX_BASE_URL=https://zabbix.exemplo.com.br/zabbix
ZABBIX_USER=usuario_relatorio
ZABBIX_PASSWORD=troque_esta_senha
# Verificar certificado TLS (true/false)
ZABBIX_VERIFY_TLS=true

# Clientes, dashboards, hosts e e-mails de destino ficam em clients.json (veja clients.example.json)
CLIENTS_FILE=./clients.json
# Gráficos por página no PDF
ZABBIX_CHARTS_PER_PAGE=3
# Máximo de gráficos por host (0 = todos)
ZABBIX_CHARTS_MAX=0
# Filtro opcional pelo nome do gráfico (ex: CPU); vazio = todos
ZABBIX_CHARTS_NAME_FILTER=
# Período (sintaxe de tempo do Zabbix)
ZABBIX_TIME_FROM=now-7d
ZABBIX_TIME_TO=now
# Pausa extra (segundos) após networkidle para os gráficos terminarem de renderizar
ZABBIX_EXTRA_WAIT_SECONDS=8
# Largura/altura do viewport headless
ZABBIX_VIEWPORT_WIDTH=1920
ZABBIX_VIEWPORT_HEIGHT=1080
# Modo kiosk (esconde menus do Zabbix): true/false
ZABBIX_KIOSK=false

# ---- Relatório ----
# {cliente} é substituído pelo nome da empresa
REPORT_TITLE=Relatório Semanal de Monitoramento - {cliente}
REPORT_OUTPUT_DIR=./output
# Dias para manter PDFs antigos (0 = nunca apagar)
REPORT_RETENTION_DAYS=90
# Arquivo de log (rotativo, 2 MB x 10 arquivos)
LOG_FILE=./logs/zabbix_report.log

# ---- SMTP ----
SMTP_HOST=smtp.exemplo.com.br
SMTP_PORT=587
# starttls | ssl | none
SMTP_SECURITY=starttls
# Validar certificado TLS do SMTP (use false só se o certificado não bater com o host)
SMTP_VERIFY_TLS=true
SMTP_USER=relatorios@exemplo.com.br
SMTP_PASSWORD=troque_esta_senha
MAIL_FROM=relatorios@exemplo.com.br
# SOMENTE PARA TESTES: se preenchido, TODOS os e-mails vão para este endereço (ignora mail_to/mail_cc dos clientes)
MAIL_TO_OVERRIDE=
# {cliente} é substituído pelo nome da empresa
MAIL_SUBJECT=Relatório semanal Zabbix - {cliente}
